# frozen_string_literal: true

# Tracks whatever is currently published on rubygems.org for the non-blocking
# "latest release" parity check (see scripts/use-latest-release.sh).
# Deliberately unpinned and lockfile-free: bundler resolves the current
# release each run. The blocking check uses ruby/Gemfile; the branch-tip check
# uses ruby/Gemfile.main.
source "https://rubygems.org"

gem "holidays"
