# frozen_string_literal: true

# Tracks the tip of the gem's default branch for the non-blocking "main" parity
# check (see scripts/use-main.sh). Deliberately has no lockfile: bundler
# resolves the current tip each run. The blocking check uses ruby/Gemfile.
source "https://rubygems.org"

gem "holidays", git: "https://github.com/holidays/holidays.git", branch: "master"
